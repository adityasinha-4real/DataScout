# DataScout environment contract.
# Copy to .env and fill in real values:  cp .env.example .env
# Every variable the code reads is listed here. Required vars have no safe
# default and the backend refuses to boot without them.

# --- Backend (required) ---

# Signing key for JWT access tokens. REQUIRED. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# --- Backend (optional, defaults shown) ---

# Runtime mode. One of: development | test | production.
# In production the API never returns stack traces.
NODE_ENV=development

# TCP port the API listens on.
PORT=4000

# SQLite database location. A filesystem path, or ":memory:" for an ephemeral
# database that is discarded on shutdown (used by the test suite).
DATABASE_URL=./data/datascout.db

# How long an issued access token (and the session cookie) stays valid, in
# seconds. 900 = 15 minutes, also what the production image sets. There is no
# refresh token, so a session ends after this and the user signs in again.
# If unset, the code falls back to 3600 (pinned by the frozen app.test.js).
JWT_EXPIRES_IN=900

# Browser origin(s) allowed to call the API cross-origin with credentials.
# Normally not needed: the frontend reaches the API through a same-origin /api
# rewrite (Vercel) or proxy (Vite), so no browser needs CORS. Blank in
# production = no CORS headers for anyone (the production default); outside
# production it defaults to the Vite dev origin. Exact origins, comma-separated;
# https only in production; "*" is refused at boot.
CORS_ORIGIN=http://localhost:5173

# Most POSTs to /api/auth/login and /api/auth/register (combined) allowed per
# client IP in any 60-second window. The next one gets 429 RATE_LIMITED with a
# Retry-After header in seconds.
AUTH_RATE_LIMIT_PER_MIN=10

# Reverse-proxy hops between the internet and the API. Leave 0 when clients
# connect directly: X-Forwarded-For is then ignored, so it cannot be forged to
# dodge the rate limit. Set 1 behind one proxy (a load balancer, Fly, Render),
# otherwise every client shares the proxy's IP and one rate-limit budget. The
# production image (backend/Dockerfile) sets 1; use 2 behind Vercel's rewrite
# plus a host router. The limiter is in memory: it resets on restart and is
# not shared between replicas.
TRUST_PROXY=0

# Largest CSV upload accepted, in bytes. Larger bodies are rejected with 413.
MAX_UPLOAD_BYTES=10485760

# API key for the model behind "Ask a question". Leave blank to run without it:
# /ask then answers 503 LLM_UNAVAILABLE and every other route works as normal.
ANTHROPIC_API_KEY=

# Model used to translate a question into a query spec.
LLM_MODEL=claude-sonnet-5

# --- Frontend (build time, must be prefixed VITE_) ---

# Leave blank: the app then calls relative /api paths on its own origin, which
# Vercel (vercel.mjs) or Vite's proxy forwards to the API. Set an absolute URL
# only for a deliberate cross-origin setup (then also set CORS_ORIGIN).
# Injected at build time.
VITE_API_BASE_URL=

# Dev/preview only (read by frontend/vite.config.ts, not by the bundle): where
# Vite's /api proxy forwards. Defaults to the local API on PORT 4000.
API_PROXY_TARGET=http://localhost:4000

# Vercel build only (read by frontend/vercel.mjs): the API's https origin that
# /api/* is rewritten to. The build fails if it is missing, http or has a path.
API_ORIGIN=https://api.example.com

# --- End-to-end tests (optional, defaults shown) ---

# Port the Playwright run boots the API on. Kept off the development port so
# an e2e run cannot collide with a server you already have running.
E2E_API_PORT=4310

# Port the Playwright run serves the built frontend on.
E2E_WEB_PORT=4311
