# DataScout environment contract.
# Copy to .env and fill in real values:  cp .env.example .env
# Every variable the code reads is listed here. Required vars have no safe
# default and the backend refuses to boot without them.

# --- Backend (required) ---

# Signing key for JWT access tokens. REQUIRED. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# --- Backend (optional, defaults shown) ---

# Runtime mode. One of: development | test | production.
# In production the API never returns stack traces.
NODE_ENV=development

# TCP port the API listens on.
PORT=4000

# SQLite database location. A filesystem path, or ":memory:" for an ephemeral
# database that is discarded on shutdown (used by the test suite).
DATABASE_URL=./data/datascout.db

# How long an issued access token stays valid, in seconds.
JWT_EXPIRES_IN=3600

# Browser origin allowed to call the API (CORS). Use "*" to allow any origin.
CORS_ORIGIN=http://localhost:5173

# Largest CSV upload accepted, in bytes. Larger bodies are rejected with 413.
MAX_UPLOAD_BYTES=10485760

# --- Frontend (build time, must be prefixed VITE_) ---

# Base URL the browser uses to reach the API. Injected at build time by Vite.
VITE_API_BASE_URL=http://localhost:4000

# --- End-to-end tests (optional, defaults shown) ---

# Port the Playwright run boots the API on. Kept off the development port so
# an e2e run cannot collide with a server you already have running.
E2E_API_PORT=4310

# Port the Playwright run serves the built frontend on.
E2E_WEB_PORT=4311
