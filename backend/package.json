{
  "name": "datascout-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=../.env --env-file-if-exists=.env src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-reporter=spec \"test/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
